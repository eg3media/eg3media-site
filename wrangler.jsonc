// eg3media.com on Cloudflare: plain static files, no build step.
// Cloudflare builds this from GitHub on every push to main (Workers & Pages, eg3media-site).
{
  "name": "eg3media-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
